# Copia este archivo como .env junto a docker-compose.yml.
# Copy this file to .env beside docker-compose.yml.
# Guía / Guide: https://github.com/NGarate/stoky/blob/master/docs/INSTALL.md

# Usa los archivos de la misma versión. / Keep all files on the same release.
STOKY_VERSION=v0.1.0-alpha.2

# Dominio con DNS hacia tu servidor, sin https://, puerto ni ruta.
# Domain pointing to your server; no scheme, port or path.
DOMAIN=

# Correo para Let's Encrypt. / Email for Let's Encrypt.
ACME_EMAIL=

# Genera DOS valores distintos con: openssl rand -hex 32
# Generate TWO different values with: openssl rand -hex 32
# Contraseña PostgreSQL: usa solo caracteres hexadecimales (0-9, a-f).
# PostgreSQL password: use hexadecimal only to avoid URL escaping.
POSTGRES_PASSWORD=
NEXTAUTH_SECRET=

# No cambies estas claves después de instalar sin seguir la guía.
# Do not change these keys after installation without following the guide.
# DATABASE_URL, VALKEY_URL y NEXTAUTH_URL se construyen en Compose.
# Compose derives the database, cache and authentication URLs automatically.
