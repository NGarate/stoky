# Copia este archivo como .env junto a docker-compose.yml.
# Guía: https://github.com/NGarate/stoky/blob/master/docs/INSTALL.md

# Versión de Stoky. Usa los archivos de esta misma versión.
STOKY_VERSION=v0.1.0-alpha.4

# Dominio que apunta a tu servidor, sin https://, puerto ni ruta.
DOMAIN=

# Correo para Let's Encrypt.
ACME_EMAIL=

# Genera dos valores distintos con: openssl rand -hex 32
POSTGRES_PASSWORD=
STOKY_SECRET=

# Quién puede crear una cuenta en /register:
#   first-user: solo la primera cuenta; las demás las añade quien administra el hogar.
#   closed:     nadie.
#   open:       cualquiera que llegue al servidor.
STOKY_REGISTRATION=first-user

# Cuántos tickets se leen a la vez por dentro: cada lector usa unos 120 MB de
# memoria y un núcleo. Con 3 un ticket tarda menos de la mitad que con 1
# (16 s frente a 38 s). Nunca usa más núcleos de los que hay.
OCR_WORKERS=3

# Opcional. De quién se creen las cabeceras X-Forwarded-*: direcciones y rangos
# CIDR separados por comas. Sin definir, la red del Traefik incluido. Cámbialo
# solo si pones otro proxy delante o cambias esa red (docs/INSTALL.md).
# STOKY_TRUSTED_PROXIES=
