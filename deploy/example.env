# Copia este archivo como .env junto a docker-compose.yml.
# Guía: https://github.com/NGarate/stoky/blob/master/docs/INSTALL.md

# Versión de Stoky. Usa los archivos de esta misma versión.
STOKY_VERSION=v0.1.0-alpha.4

# Nombre con el que se abre Stoky, sin https://, puerto ni ruta. Tu proxy
# inverso sirve https://DOMAIN y reenvía al puerto de abajo.
DOMAIN=

# Genera dos valores distintos con: openssl rand -hex 32
POSTGRES_PASSWORD=
STOKY_SECRET=

# Quién puede crear una cuenta en /register:
#   first-user: solo la primera cuenta; las demás las añade quien administra el hogar.
#   closed:     nadie.
STOKY_REGISTRATION=first-user

# Cuántos tickets se leen a la vez por dentro: cada lector usa unos 120 MB de
# memoria y un núcleo. Con 3 un ticket tarda menos de la mitad que con 1
# (16 s frente a 38 s). Nunca usa más núcleos de los que hay.
OCR_WORKERS=3

# Opcional. Dirección de este equipo en la que Stoky atiende por HTTP, para tu
# proxy. Sin definir, en todas las direcciones IPv4. Con el proxy en este
# mismo equipo, quita la almohadilla: solo lo alcanzan sus propios programas.
# STOKY_BIND=127.0.0.1

# Opcional. El puerto de este equipo, si el 3000 ya está ocupado.
# STOKY_PORT=3000

# De quién se creen las cabeceras X-Forwarded-*: la dirección de tu proxy, o
# varias direcciones y rangos CIDR separados por comas. Sin definir, de nadie:
# todas las visitas cuentan como si vinieran del proxy y comparten los límites
# de intentos de inicio de sesión. La guía dice qué poner con cada proxy.
# STOKY_TRUSTED_PROXIES=
