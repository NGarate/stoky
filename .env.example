# =============================================================================
# Stoky — Environment Configuration
# =============================================================================
# Copy to .env:  cp .env.example .env
# Start services: bun run dev:services   (or: bash scripts/dev-local.sh)

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# Connects to the Docker container started by docker-compose.dev.yml.
# Port 5432 is exposed to localhost so the host-side app and tools can reach it.
#
# **Development only.** For docker-compose.prod.yml both the host and the
# password are different — see the production section at the bottom of this
# file, which explains why copying this line unchanged produces an app that
# cannot reach its own database.
DATABASE_URL="postgresql://stoky:stoky_dev_password@localhost:5432/stoky?schema=public"

# For full-Docker mode (docker-compose.yml — app also runs in a container):
# DATABASE_URL="postgresql://stoky:stoky_dev_password@db:5432/stoky?schema=public"

# -----------------------------------------------------------------------------
# Cache (Valkey / Redis-compatible)
# -----------------------------------------------------------------------------
# Connects to the Docker container started by docker-compose.dev.yml.
# Port 6379 is exposed to localhost.
VALKEY_URL="redis://localhost:6379"

# For full-Docker mode (docker-compose.yml):
# VALKEY_URL="redis://cache:6379"

# -----------------------------------------------------------------------------
# Authentication rate limiting (ISSUES.md CRITICAL-4)
# -----------------------------------------------------------------------------
# Counted in Valkey, per IP and — for sign-in — per account. The defaults below
# are the specification in CLAUDE.md and are what ships when these are unset —
# leave them alone unless you have a reason. Raising them raises the exposure of
# the login form.
#
# The per-account limit is the one that bounds a guess spread across many
# addresses: without it, an attacker with a hundred of them gets a hundred
# budgets against one password. It is higher than the per-IP number because a
# household legitimately signs in from a phone, a tablet and a laptop, and this
# counter cannot tell them apart. A successful sign-in clears both.
#
# Note that signing in depends on Valkey: the limiter fails closed, so an
# attempt it cannot count is an attempt it refuses. See SECURITY.md.
# RATE_LIMIT_LOGIN_ATTEMPTS="5"
# RATE_LIMIT_LOGIN_WINDOW_SECONDS="900"
# RATE_LIMIT_LOGIN_ACCOUNT_ATTEMPTS="10"
# RATE_LIMIT_LOGIN_ACCOUNT_WINDOW_SECONDS="900"
# RATE_LIMIT_REGISTER_ATTEMPTS="3"
# RATE_LIMIT_REGISTER_WINDOW_SECONDS="3600"

# Receipt upload, counted per account rather than per address — the caller is
# already signed in, and an account is the thing that can be held responsible.
# One upload is up to 10MB decoded, re-encoded through Sharp, written to disk
# and then handed to Tesseract, which is why it is metered at all.
# RATE_LIMIT_UPLOAD_ATTEMPTS="30"
# RATE_LIMIT_UPLOAD_WINDOW_SECONDS="3600"

# -----------------------------------------------------------------------------
# NextAuth.js (Auth.js v5)
# -----------------------------------------------------------------------------
# **Development only**, like DATABASE_URL above. In production this has to be
# the address people actually type — `https://` and the DOMAIN set further down
# — because Auth.js builds callback URLs from it.
#
# The `UntrustedHost` failure this note first described turned out **not** to be
# about this variable at all: a production build refused the host even with
# NEXTAUTH_URL matching its own address exactly. That was Auth.js v5 defaulting
# `trustHost` to false, and it is fixed in `src/lib/auth.ts`. Setting this
# correctly still matters for the links in callbacks, but it is no longer the
# difference between working and not.
NEXTAUTH_URL="http://localhost:3000"
# Generate a secret:  openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# -----------------------------------------------------------------------------
# Production — docker-compose.prod.yml
# -----------------------------------------------------------------------------
# These three create the database container. Only these three: `docker-compose.
# dev.yml` hardcodes its own, which is why development works whatever you put
# here.
POSTGRES_USER=stoky
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=stoky

# **Change DATABASE_URL and VALKEY_URL above before deploying**, or the app will
# not reach either service. The values at the top of this file are for
# development and are wrong for production in two ways:
#
#   1. The host. In the compose network the app reaches the database at `db` and
#      the cache at `cache`, not at `localhost`.
#   2. The password. The database is created with POSTGRES_PASSWORD above, and
#      *nothing checks that DATABASE_URL agrees with it* — they are two separate
#      strings that have to be edited together. Copying this file unchanged
#      produces a database whose password the application does not know.
#
# Neither failure says so when it happens: the first is a connection timeout and
# the second is a bare `P1000` naming neither variable. For production, the two
# lines should read:
#
#   DATABASE_URL="postgresql://stoky:<POSTGRES_PASSWORD from above>@db:5432/stoky?schema=public"
#   VALKEY_URL="redis://cache:6379"
#   NEXTAUTH_URL="https://<DOMAIN below>"
#
# Three variables, three ways to be wrong, and none of them says which. That is
# the whole reason this section is longer than the values in it.

# Traefik / Let's Encrypt
DOMAIN=your-domain.com
ACME_EMAIL=your-email@example.com
