generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  /// The language this person reads. Beats the `locale` cookie; see src/i18n/request.ts.
  locale        String     @default("es")
  /// How long a confirmation stays on screen: "default" | "long" | "forever".
  /// A WCAG 2.2.1 adjustment, so it belongs to the person rather than to the
  /// browser — the reader who needs longer needs longer everywhere. The theme
  /// deliberately does not live here: that one is a property of the screen.
  snackbarDuration String  @default("default")
  household     Household? @relation(fields: [householdId], references: [id])
  householdId   String?
  role          HouseholdRole @default(MEMBER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([householdId])
}

model Household {
  id        String    @id @default(cuid())
  name      String
  members   User[]
  products  Product[]
  stores    Store[]
  receipts  Receipt[]
  locations StorageLocation[]
  shoppingLists ShoppingList[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String    @id @default(cuid())
  name          String
  barcode       String?
  brand         String?
  category      String?
  imageUrl      String?
  defaultUnit   String    @default("unit")
  minStock      Float?
  openFoodFactsData Json?
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  stockEntries  StockEntry[]
  priceRecords  PriceRecord[]
  receiptItems  ReceiptItem[]
  shoppingItems ShoppingItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([barcode, householdId])
  @@index([householdId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model StockEntry {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Float
  unit          String
  expirationDate DateTime?
  locationId    String?
  location      StorageLocation? @relation(fields: [locationId], references: [id])
  operationType StockOperation
  note          String?
  receiptItemId String?
  createdBy     String
  createdAt     DateTime  @default(now())

  @@index([productId])
  @@index([locationId])
}

model StorageLocation {
  id           String    @id @default(cuid())
  name         String
  parentId     String?
  parent       StorageLocation? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children     StorageLocation[] @relation("LocationHierarchy")
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  stockEntries StockEntry[]

  @@index([householdId])
  @@index([parentId])
}

model Store {
  id           String    @id @default(cuid())
  name         String
  address      String?
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  priceRecords PriceRecord[]
  receipts     Receipt[]
  shoppingItems ShoppingItem[]

  @@index([householdId])
}

model PriceRecord {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  price       Float
  currency    String    @default("EUR")
  unit        String
  quantity    Float     @default(1)
  recordedAt  DateTime  @default(now())
  receiptId   String?

  @@index([productId, recordedAt])
  @@index([storeId])
}

model Receipt {
  id            String        @id @default(cuid())
  imagePath     String
  status        ReceiptStatus @default(UPLOADING)
  storeId       String?
  store         Store?        @relation(fields: [storeId], references: [id])
  purchaseDate  DateTime?
  totalAmount   Float?
  rawOcrText    String?
  items         ReceiptItem[]
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id])
  uploadedBy    String
  createdAt     DateTime      @default(now())
  processedAt   DateTime?

  @@index([householdId, createdAt])
  @@index([storeId])
}

model ReceiptItem {
  id              String      @id @default(cuid())
  receiptId       String
  receipt         Receipt     @relation(fields: [receiptId], references: [id])
  rawText         String
  parsedName      String?
  parsedPrice     Float?
  parsedQuantity  Float?
  matchedProductId String?
  matchedProduct  Product?    @relation(fields: [matchedProductId], references: [id])
  matchConfidence Float?
  matchStatus     MatchStatus @default(PENDING)

  @@index([receiptId])
  @@index([matchedProductId])
}

model ShoppingList {
  id          String    @id @default(cuid())
  name        String
  isAutoGenerated Boolean @default(false)
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  items       ShoppingItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId])
}

model ShoppingItem {
  id             String    @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])
  /// Required. An item names a product the household knows about — free text
  /// was accepted until 2026-08-22 and cost more than it gave (D103).
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  quantity       Float     @default(1)
  unit           String?
  isChecked      Boolean   @default(false)
  checkedAt      DateTime?
  /// Where this one is meant to be bought. Per item rather than per list,
  /// because one shop rarely covers a household's week: the milk is cheapest
  /// in one place and the fruit in another, and a list that forces one store
  /// makes people keep two lists instead.
  storeId        String?
  store          Store?    @relation(fields: [storeId], references: [id])

  @@index([shoppingListId])
  @@index([productId])
  @@index([storeId])
}

enum ReceiptStatus {
  UPLOADING
  PROCESSING
  PARSED
  NEEDS_REVIEW
  CONFIRMED
  APPLIED
  FAILED
}

enum MatchStatus {
  PENDING
  AUTO_MATCHED
  USER_CONFIRMED
  USER_CREATED
  SKIPPED
}

enum StockOperation {
  PURCHASE
  CONSUME
  ADJUST
  TRANSFER
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
  KITCHEN
}

/// Which screen a person starts on. The three that exist, and no fourth.
///
/// `DASHBOARD` is the Panel, `SHOPPING` is Screen A (REDESIGN_PLAN §3) and
/// `KITCHEN` is Screen B (§4). Whether three entry points is the right number
/// is DESIGN_AUDIT A5.4's still-open half, and this enum deliberately does not
/// answer it: offering all three retires nothing, and what people actually
/// choose is the first evidence that question has ever had.
enum LandingScreen {
  DASHBOARD
  SHOPPING
  KITCHEN
}

/// Where this person, on this device, wants to land. REDESIGN_PLAN §5.1.
///
/// Keyed on the pair, and that is the requirement rather than a normalisation
/// choice: a shared tablet must not inherit the choice of whoever signed in
/// last, and a person must not be forced into the kitchen screen on their own
/// phone because they once picked up the house tablet.
///
/// `deviceId` is the cookie minted in `src/middleware.ts` — a cookie rather
/// than `localStorage` precisely so this row can be read on the server, before
/// anything is drawn, and the landing become a redirect instead of a flash.
///
/// No foreign key to User, matching `MutationReplay` above and the schema's
/// standing rule that there are no cascades. A deleted account leaves rows
/// keyed on a user id that no longer exists; nothing reads them, they are two
/// short strings each, and the alternative is a cascade this schema does not
/// have anywhere else.
model ScreenChoice {
  userId    String
  deviceId  String
  screen    LandingScreen
  updatedAt DateTime      @updatedAt

  @@id([userId, deviceId])
}

/// One record per mutation a device composed, so replaying it applies once.
///
/// A shop composed in aeroplane mode is sent when the signal returns, and the
/// send can be repeated — the reply was lost, the tab was closed mid-flight,
/// the queue was drained twice. "Consume one litre of milk" replayed twice must
/// consume one litre.
///
/// The primary key is `[userId, key]`, not `key` alone, and that is the control
/// rather than an optimisation. In a global key space, someone who guesses a
/// key can claim it first, suppress the victim's genuine write, and have the
/// victim answered with their outcome. Partitioned by a server-derived
/// `userId`, key entropy stops being a security property at all.
///
/// `resultIds` holds ids, not the result. A re-read returns rows the caller is
/// authorised to see *at replay time*, and a row deleted in between yields an
/// honest NOT_FOUND rather than a ghost — and this table never becomes a second
/// copy of the household's data, which for a privacy-first application is the
/// wrong thing to keep.
///
/// No foreign key to User: the schema has no cascades, and a cascade would take
/// a KEY SHARE lock on the user row on every replayable write.
model MutationReplay {
  key         String
  userId      String
  householdId String
  procedure   String
  requestHash String
  resultIds   String[]
  createdAt   DateTime @default(now())
  expiresAt   DateTime

  @@id([userId, key])
  @@index([expiresAt])
}
