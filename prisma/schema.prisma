generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  name          String
  passwordHash  String
  locale        String     @default("es")
  household     Household? @relation(fields: [householdId], references: [id])
  householdId   String?
  role          HouseholdRole @default(MEMBER)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Household {
  id        String    @id @default(cuid())
  name      String
  members   User[]
  products  Product[]
  stores    Store[]
  receipts  Receipt[]
  locations StorageLocation[]
  shoppingLists ShoppingList[]
  createdAt DateTime  @default(now())
}

model Product {
  id            String    @id @default(cuid())
  name          String
  barcode       String?
  brand         String?
  category      String?
  imageUrl      String?
  defaultUnit   String    @default("unit")
  minStock      Float?
  openFoodFactsData Json?
  householdId   String
  household     Household @relation(fields: [householdId], references: [id])
  stockEntries  StockEntry[]
  priceRecords  PriceRecord[]
  receiptItems  ReceiptItem[]
  shoppingItems ShoppingItem[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([barcode, householdId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
}

model StockEntry {
  id            String    @id @default(cuid())
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  quantity      Float
  unit          String
  expirationDate DateTime?
  locationId    String?
  location      StorageLocation? @relation(fields: [locationId], references: [id])
  operationType StockOperation
  note          String?
  receiptItemId String?
  createdBy     String
  createdAt     DateTime  @default(now())
}

model StorageLocation {
  id           String    @id @default(cuid())
  name         String
  parentId     String?
  parent       StorageLocation? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children     StorageLocation[] @relation("LocationHierarchy")
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  stockEntries StockEntry[]
}

model Store {
  id           String    @id @default(cuid())
  name         String
  address      String?
  householdId  String
  household    Household @relation(fields: [householdId], references: [id])
  priceRecords PriceRecord[]
  receipts     Receipt[]
}

model PriceRecord {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  storeId     String
  store       Store     @relation(fields: [storeId], references: [id])
  price       Float
  currency    String    @default("EUR")
  unit        String
  quantity    Float     @default(1)
  recordedAt  DateTime  @default(now())
  receiptId   String?
}

model Receipt {
  id            String        @id @default(cuid())
  imagePath     String
  status        ReceiptStatus @default(UPLOADING)
  storeId       String?
  store         Store?        @relation(fields: [storeId], references: [id])
  purchaseDate  DateTime?
  totalAmount   Float?
  rawOcrText    String?
  items         ReceiptItem[]
  householdId   String
  household     Household     @relation(fields: [householdId], references: [id])
  uploadedBy    String
  createdAt     DateTime      @default(now())
  processedAt   DateTime?
}

model ReceiptItem {
  id              String      @id @default(cuid())
  receiptId       String
  receipt         Receipt     @relation(fields: [receiptId], references: [id])
  rawText         String
  parsedName      String?
  parsedPrice     Float?
  parsedQuantity  Float?
  matchedProductId String?
  matchedProduct  Product?    @relation(fields: [matchedProductId], references: [id])
  matchConfidence Float?
  matchStatus     MatchStatus @default(PENDING)
}

model ShoppingList {
  id          String    @id @default(cuid())
  name        String
  isAutoGenerated Boolean @default(false)
  householdId String
  household   Household @relation(fields: [householdId], references: [id])
  items       ShoppingItem[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ShoppingItem {
  id             String    @id @default(cuid())
  shoppingListId String
  shoppingList   ShoppingList @relation(fields: [shoppingListId], references: [id])
  productId      String?
  product        Product?  @relation(fields: [productId], references: [id])
  customName     String?
  quantity       Float     @default(1)
  unit           String?
  isChecked      Boolean   @default(false)
  checkedAt      DateTime?
}

enum ReceiptStatus {
  UPLOADING
  PROCESSING
  PARSED
  NEEDS_REVIEW
  CONFIRMED
  APPLIED
  FAILED
}

enum MatchStatus {
  PENDING
  AUTO_MATCHED
  USER_CONFIRMED
  USER_CREATED
  SKIPPED
}

enum StockOperation {
  PURCHASE
  CONSUME
  ADJUST
  TRANSFER
}

enum HouseholdRole {
  OWNER
  ADMIN
  MEMBER
}
