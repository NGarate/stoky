# Dependencies
node_modules
# Host package caches and obsolete package-manager manifests are not source.
store
.pnpm-store
pnpm-lock.yaml
pnpm-workspace.yaml

# Build output
.next
out

# Version control
.git
.gitignore

# Environment (secrets). Every variant, not a list of the usual three: Next's
# standalone output copies `.env.production` into the image, and Bun loads it at
# start, so an unlisted one ships its secrets in a layer.
.env*
!.env.example

# IDE / editor
.vscode
.cursor
.idea
*.swp
*.swo

# Documentation (not needed in image)
*.md
docs/
LICENSE

# Test artifacts
coverage
test-results
playwright-report
.playwright-cli

# Upload data (mounted as volume)
uploads

# OS files
.DS_Store
Thumbs.db
