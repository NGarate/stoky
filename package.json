{
  "name": "stoky",
  "version": "1.0.0",
  "description": "Privacy-first household inventory management",
  "scripts": {
    "dev": "next dev",
    "dev:setup": "bash scripts/dev-local.sh",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "dev:services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:components && pnpm test:integration",
    "test:unit": "bun test src/__tests__/unit",
    "test:components": "bun test --preload ./src/__tests__/setup/register-dom.ts src/__tests__/components",
    "test:integration": "bash scripts/test-integration-local.sh",
    "test:integration:only": "bun test src/__tests__/integration",
    "verify:local": "bash scripts/verify-local.sh",
    "verify:ci": "bash scripts/verify-local.sh --ci",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "bun run prisma/seed.ts"
  },
  "keywords": [
    "inventory",
    "household",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.66.0",
    "@thewirv/react-barcode-scanner": "^3.4.0",
    "@trpc/client": "^11.0.0-rc.802",
    "@trpc/react-query": "^11.0.0-rc.802",
    "@trpc/server": "^11.0.0-rc.802",
    "@types/node": "^22.19.10",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.12",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.9.2",
    "postcss": "^8.5.25",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.4.0",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "^6.0.0",
    "typescript": "^5.9.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@happy-dom/global-registrator": "^20.11.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.2.2",
    "@types/react-test-renderer": "^19.1.0",
    "happy-dom": "^20.11.1",
    "oxlint": "^0.16.12",
    "playwright": "^1.58.2"
  },
  "pnpm": {
    "overrides": {
      "@parcel/watcher>picomatch": "^4.0.5",
      "recharts>lodash": "^4.18.1",
      "@prisma/config>effect": "^3.22.1",
      "c12>defu": "^6.1.7"
    }
  }
}
