{
  "name": "stoky",
  "version": "0.1.0-alpha.4",
  "description": "Privacy-first household inventory management",
  "scripts": {
    "dev": "bun --bun node_modules/next/dist/bin/next dev",
    "dev:setup": "bash scripts/dev-local.sh",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "dev:services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "build": "bun --bun node_modules/next/dist/bin/next build",
    "start": "bun --bun node_modules/next/dist/bin/next start",
    "lint": "bun --bun node_modules/oxlint/bin/oxlint",
    "typecheck": "bun --bun node_modules/typescript/bin/tsc --noEmit",
    "check:react": "bun --bun node_modules/react-doctor/bin/react-doctor.js . --no-telemetry --no-supply-chain --no-warnings --blocking error --max-duration 120",
    "check:contrast": "bun scripts/check-contrast.ts",
    "check:links": "bun scripts/check-links.ts",
    "check:audit": "bash scripts/check-audit.sh",
    "check:all": "bash scripts/check-scope.sh all",
    "check:staged": "bash scripts/check-scope.sh staged",
    "check:changed": "bash scripts/check-scope.sh changed",
    "test": "bun run test:unit && bun run test:components && bun run test:integration",
    "test:unit": "bun test src/__tests__/unit",
    "test:components": "bun test --preload ./src/__tests__/setup/register-dom.ts src/__tests__/components",
    "test:integration": "bash scripts/test-integration-local.sh",
    "test:integration:only": "bun test src/__tests__/integration",
    "test:e2e": "bash scripts/e2e-in-image.sh",
    "verify:local": "bash scripts/verify-local.sh",
    "verify:ci": "bash scripts/verify-local.sh --ci",
    "release:version": "bun scripts/release-version.ts",
    "release:refresh-images": "bun scripts/release-refresh-images.ts",
    "release:prepare": "bun scripts/release-prepare.ts",
    "release:tag": "bun scripts/release-tag.ts",
    "release:verify": "bash scripts/release-verify-draft.sh",
    "release:publish": "bash scripts/release-publish.sh",
    "db:migrate": "bun --bun node_modules/prisma/build/index.js migrate dev",
    "db:generate": "bun --bun node_modules/prisma/build/index.js generate",
    "db:seed": "bun --bun node_modules/prisma/build/index.js db seed"
  },
  "keywords": [
    "inventory",
    "household",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@better-auth/passkey": "1.7.12",
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-toast": "^1.3.1",
    "@simplewebauthn/browser": "13.3.0",
    "@tanstack/query-sync-storage-persister": "5.104.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-query-persist-client": "5.104.5",
    "@thewirv/react-barcode-scanner": "^3.4.0",
    "@trpc/client": "^11.19.0",
    "@trpc/react-query": "^11.19.0",
    "@trpc/server": "^11.19.0",
    "argon2": "^0.41.1",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "next-intl": "^4.14.9",
    "prisma": "^6.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "recharts": "^3.10.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^6.0.1",
    "uqr": "0.1.3",
    "zod": "^4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@happy-dom/global-registrator": "^21.0.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/typescript6": "^6.0.2",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "happy-dom": "^21.0.4",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "react-doctor": "0.9.18",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "argon2",
    "prisma"
  ],
  "overrides": {
    "effect": "^3.22.1",
    "defu": "^6.1.7",
    "nanoid": "^3.3.18",
    "deepmerge-ts": "^8.0.0",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.12"
  }
}
