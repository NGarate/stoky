{
  "name": "stoky",
  "version": "1.0.0",
  "description": "Privacy-first household inventory management",
  "scripts": {
    "dev": "next dev",
    "dev:setup": "bash scripts/dev-local.sh",
    "dev:services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:services:down": "docker compose -f docker-compose.dev.yml down",
    "dev:services:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:components && pnpm test:integration",
    "test:unit": "bun test src/__tests__/unit",
    "test:components": "bun test src/__tests__/components src/__tests__/utils",
    "test:integration": "bash scripts/test-integration-local.sh",
    "test:integration:only": "bun test src/__tests__/integration",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed"
  },
  "keywords": [
    "inventory",
    "household",
    "management"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.1",
  "dependencies": {
    "@auth/prisma-adapter": "^2.7.4",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@tanstack/react-query": "^5.66.0",
    "@thewirv/react-barcode-scanner": "^3.4.0",
    "@trpc/client": "^11.0.0-rc.802",
    "@trpc/react-query": "^11.0.0-rc.802",
    "@trpc/server": "^11.0.0-rc.802",
    "@types/node": "^22.19.10",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "argon2": "^0.41.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.563.0",
    "next": "^16.2.6",
    "next-auth": "5.0.0-beta.30",
    "next-intl": "^4.8.2",
    "postcss": "^8.5.6",
    "prisma": "^6.19.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^14.4.0",
    "recharts": "^2.15.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "superjson": "^2.2.2",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tesseract.js": "^6.0.0",
    "typescript": "^5.9.3",
    "zod": "^3.24.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@playwright/test": "^1.58.2",
    "@types/bun": "^1.2.2",
    "oxlint": "^0.16.12",
    "playwright": "^1.58.2"
  }
}
